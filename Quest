    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #030712;
            color: #f3f4f6;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }

        .font-cinzel { font-family: 'Cinzel', serif; }
        .font-handwriting { font-family: 'Caveat', cursive; }

        .glow-title {
            text-shadow: 0 0 15px rgba(168, 85, 247, 0.6), 0 0 30px rgba(99, 102, 241, 0.4);
        }

        /* 3D Envelope Styling */
        .envelope-container {
            perspective: 1000px;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            padding: 20px 0;
        }

        .envelope {
            position: relative;
            width: 310px;
            height: 200px;
            background: #1e1b4b;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(168, 85, 247, 0.35);
            cursor: pointer;
            transition: transform 0.6s cubic-bezier(0.34, 1.25, 0.64, 1);
        }

        .envelope:hover {
            transform: translateY(-4px) scale(1.02);
        }

        .envelope.open {
            transform: translateY(80px);
        }

        .envelope-flap {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 155px solid transparent;
            border-right: 155px solid transparent;
            border-top: 115px solid #312e81;
            transform-origin: top;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), z-index 0.6s;
            z-index: 4;
            filter: drop-shadow(0 3px 6px rgba(0,0,0,0.4));
        }

        .envelope.open .envelope-flap {
            transform: rotateX(180deg);
            z-index: 1;
        }

        .wax-seal {
            position: absolute;
            top: 80px;
            left: 135px;
            width: 40px;
            height: 40px;
            background: radial-gradient(circle, #fbbf24, #b45309);
            border: 2px solid #fef08a;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #451a03;
            font-size: 16px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.6);
            z-index: 5;
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .envelope.open .wax-seal {
            opacity: 0;
            transform: scale(0.5);
            pointer-events: none;
        }

        .envelope-pocket-left {
            position: absolute;
            top: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 160px solid #2e1065;
            border-top: 100px solid transparent;
            border-bottom: 100px solid transparent;
            border-radius: 12px 0 0 12px;
            z-index: 3;
            pointer-events: none;
        }

        .envelope-pocket-right {
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            border-right: 160px solid #2e1065;
            border-top: 100px solid transparent;
            border-bottom: 100px solid transparent;
            border-radius: 0 12px 12px 0;
            z-index: 3;
            pointer-events: none;
        }

        .envelope-pocket-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 0;
            border-left: 155px solid transparent;
            border-right: 155px solid transparent;
            border-bottom: 115px solid #3b0764;
            border-radius: 0 0 12px 12px;
            z-index: 3;
            pointer-events: none;
            filter: drop-shadow(0 -2px 4px rgba(0,0,0,0.3));
        }

        .letter {
            position: absolute;
            bottom: 10px;
            left: 12px;
            width: 286px;
            height: 175px;
            background: #fffdfa;
            color: #0f172a;
            border-radius: 8px;
            padding: 16px;
            transition: transform 0.8s cubic-bezier(0.34, 1.25, 0.64, 1), height 0.8s, z-index 0.8s;
            z-index: 2;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            overflow-y: auto;
            border: 1px solid #fef3c7;
        }

        .envelope.open .letter {
            transform: translateY(-185px) scale(1.05);
            z-index: 10;
            height: 330px;
            max-height: 52vh;
        }

        @keyframes keyFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-8px) scale(1.05); }
        }

        .key-animate {
            animation: keyFloat 2s ease-in-out infinite;
        }

        .dpad-btn {
            background-color: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            font-size: 1.25rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
            transition: all 0.08s ease;
            touch-action: manipulation;
        }

        .dpad-btn:active, .dpad-btn.active-btn {
            background-color: #4f46e5;
            border-color: #818cf8;
            transform: scale(0.92);
        }

        .action-btn {
            background: linear-gradient(135deg, #eab308, #ca8a04);
            border: 1px solid #fef08a;
            color: #451a03;
            font-weight: 800;
            font-size: 0.7rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(234, 179, 8, 0.4);
            transition: all 0.08s ease;
        }

        .action-btn:active, .action-btn.active-btn {
            background: #facc15;
            transform: scale(0.92);
        }

        .audio-btn {
            background-color: rgba(30, 41, 59, 0.95);
            border: 1px solid rgba(99, 102, 241, 0.4);
            color: #818cf8;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.75rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
            transition: all 0.15s ease;
            cursor: pointer;
        }

        .audio-btn:hover {
            background-color: rgba(49, 46, 129, 0.95);
            color: #a5b4fc;
        }
    </style>
</head>
